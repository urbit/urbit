/-  spider
/+  ph=ph-io
=,  strand=strand:spider
^-  thread:spider
|=  vase
=/  m  (strand ,vase)
=+  ~(. ph %lago)
=|  tids=drivers
=/  cores=(list ?(%mesa %ames))  ~[%mesa %ames]
|-  ^-  form:m
?~  cores
  (pure:m *vase)
;<  =_tids  bind:m  start-lago
;<  ~  bind:m  (switch-network-core i.cores)
;<  ~  bind:m  (init-ship ~bud &)
;<  ~  bind:m  (init-ship ~dev &)
;<  ~  bind:m  (dojo ~bud "-peek ~dev^/c/x/1/kids/sys/kelvin ~")
;<  ~  bind:m  (wait-for-output ~bud "kal=[lal=%zuse num={(scow %ud zuse)}]")
;<  ~  bind:m  (end tids)
;<  ~  bind:m  (send-events ~[reset-routing/~])
$(cores t.cores)